# ==========================
# Carpetas generadas por Unity
# ==========================
.vs/
Library/
Temp/
Obj/
Build/
Builds/
Logs/
UserSettings/
MemoryCaptures/

# ==========================
# Archivos de proyecto/solución autogenerados (VS / Rider / IDE)
# Unity los regenera al abrir el proyecto
# ==========================
.vsconfig
*.csproj
*.sln
*.unityproj
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.tmp

# ==========================
# Artefactos de build
# ==========================
*.apk
*.aab
*.unitypackage
*.app

# ==========================
# Varios
# ==========================
# Los .meta solo se ignoran si su asset correspondiente también se ignora
!/[Aa]ssets/**/*.meta
